# PostgreSQL connection string (Render/Railway/Supabase all provide this)
DATABASE_URL="postgresql://user:password@host:5432/notes_db?schema=public"

# Server
PORT=4000

# JWT secrets — generate strong random strings for production
# e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"

# Token lifetimes
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Comma-separated list of allowed origins for CORS (use * for development only)
CORS_ORIGIN="*"
